{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BudgetOS",
  "version": "0.1.0",
  "identifier": "com.balabalaji.budgetos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BudgetOS",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ]
  }
}
